# Browser stays same-origin; rewrites only apply when a real API base is configured.
NEXT_PUBLIC_API_BASE_URL=/api

# Vercel / pure-frontend deploy: leave SERVER_API_BASE_URL unset so SSR does not
# hammer 127.0.0.1:8080 (no colocated Java). Self-hosted OpenResty setups can set:
# SERVER_API_BASE_URL=http://127.0.0.1:8080/api
